                      ],
                      "limitations": [
                        "Only 10 seconds observed; this does not represent the entire hour.",
                        "Synthetic values."
                      ]
                    }
                  },
                  "empty": {
                    "value": {
                      "locationId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
                      "from": "2026-11-08T15:00:00Z",
                      "to": "2026-11-08T15:01:00Z",
                      "timezone": "America/Sao_Paulo",
                      "origin": "simulated",
                      "aggregation": "hour",
                      "status": "no_data",
                      "laeqDbA": null,
