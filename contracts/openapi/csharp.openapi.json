        "parameters": [
          {
            "name": "locationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": ""
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "description": "Inclusive UTC timestamp."
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "description": "Exclusive UTC timestamp; after from; maximum period 31 days."
          },
          {
            "name": "origin",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "simulated",
                "public_dataset"
              ]
            },
            "description": ""
          },
          {
            "name": "aggregation",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "hour",
                "day"
              ],
              "default": "hour"
            },
            "description": ""
          }
        ],
        "x-required-scopes": [
          "acoustics:read"
        ]
      }
    },
