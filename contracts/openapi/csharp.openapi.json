{
  "openapi": "3.1.0",
  "info": {
    "title": "Sonora | Query API",
    "version": "0.4.0",
    "description": "Private acoustic query API. Reads the published PostgreSQL views with a read-only role. No ingestion, migrations or HTTP relay from Java. JSON fields and technical errors use English. See docs/arquitetura.md and contracts/database.json."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local C# implementation"
    },
    {
      "url": "http://localhost:4010",
      "description": "Static query contract mock"
    }
  ],
  "paths": {
    "/api/sonora/v1/health/live": {
      "get": {
        "operationId": "healthLive",
        "summary": "Check process liveness",
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "security": [],
        "x-required-scopes": []
      }
    },
    "/api/sonora/v1/health/ready": {
      "get": {
        "operationId": "healthReady",
        "summary": "Check dependency readiness",
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "503": {
            "description": "Request failed. Sanitized English error response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "invalid_request",
                  "message": "Invalid request."
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "unauthorized",
                  "message": "Missing, invalid, revoked or expired API key."
