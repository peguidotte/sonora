  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "BatchRequest": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "fileId"
        ],
        "additionalProperties": false
      },
      "Batch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sourceId": {
            "type": "string",
            "format": "uuid"
          },
          "fileSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "validated",
              "delivering",
              "completed",
              "failed",
              "completed_with_errors"
            ]
          },
          "acceptedCount": {
            "type": "integer",
            "minimum": 0
          },
          "duplicateCount": {
            "type": "integer",
            "minimum": 0
          },
          "rejectedCount": {
            "type": "integer",
            "minimum": 0
          },
          "deliveryStatus": {
            "type": "string",
            "enum": [
              "pending",
              "delivering",
              "delivered",
              "failed"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          }
        },
        "required": [
          "id",
          "fileId",
          "sourceId",
          "fileSha256",
          "status",
          "acceptedCount",
          "duplicateCount",
          "rejectedCount",
          "deliveryStatus",
          "createdAt"
        ],
        "additionalProperties": false
      },
      "BatchPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Batch"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "Opaque service-specific credential. Missing, invalid, revoked or expired: 401. Valid credential without required scope: 403. Never send credentials in URLs."
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ]
}
