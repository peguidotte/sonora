      "mvn -B -f soa/pom.xml verify",
      "java -jar soa/target/sonora-ingestion-0.1.0-SNAPSHOT.jar"
    ],
    "dataMode": "postgresql-and-local-inputs"
  },
  "integrated": {
    "status": "planned",
    "dependencies": [
      "postgresql"
    ]
  },
  "validation": {
    "commands": [
      "mvn -B -f soa/pom.xml verify",
      "python tools/check_database_compatibility.py --baseline-ref origin/main"
    ],
    "evidence": []
  },
  "deployment": {
    "target": "azure-vm",
    "status": "not-deployed"
  }
